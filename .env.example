# --- VK ---
VK_TOKEN=replace_me_with_group_token

# --- Приложение ---
APP_ENV=development
LOG_LEVEL=INFO

# --- База данных ---
DATABASE_URL=sqlite+aiosqlite:///./translate.db

# --- Провайдеры перевода ---
# Основной: MyMemory (бесплатный, без ключа, лимит 500 симв.)
MYMEMORY_URL=https://api.mymemory.translated.net/get
# Fallback: LibreTranslate (публичный инстанс; замените при желании)
LIBRETRANSLATE_URL=https://translate.terraprint.co/translate
TRANSLATE_TIMEOUT=15
